{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "b45afa0ef662c5bd6dd507ea65c81b71",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techbook-log",
      "database_id": "7bdbf251-ca07-48bb-8b89-ace6744c780a",
      "migrations_dir": "drizzle",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {
    "ENV": "development",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ORIGIN_URL": "http://localhost:3000",
    "RESEND_FROM_EMAIL": "noreply@memetec.dev",
  },
  "env": {
    "production": {
      "name": "api",
      "vars": {
        "ENV": "production",
        "ORIGIN_URL": "https://memetec.dev",
        "BETTER_AUTH_URL": "https://api.memetec.dev",
        "RESEND_FROM_EMAIL": "noreply@memetec.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techbook-log",
          "database_id": "7bdbf251-ca07-48bb-8b89-ace6744c780a",
          "migrations_dir": "drizzle",
        },
      ],
    },
  },
}
